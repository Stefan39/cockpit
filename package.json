{
  "name": "@stefan39/cockpit",
  "version": "1.4.0",
  "private": true,
  "description": "Betriebs-Cockpit der KI-Automatisierungs-Box — Fastify/TypeScript, serverseitig gerendert.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json",
    "./testen/fach-migrationen": "./scripts/dev/fach-migrationen.ts",
    "./testen/*": "./test/*.ts",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "db/migrate.ts",
    "db/migrations",
    "config",
    "views",
    "assets",
    "scripts/dev/fach-migrationen.ts",
    "test/global-setup.ts",
    "test/hilfen.ts",
    "test/testdatenbank.ts",
    "test/global-setup-assets.ts",
    "test/webauthn-authenticator.ts",
    "test/qr-lesen.ts",
    "tsconfig.build.json",
    "tsconfig.json",
    "src"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:stack": "sh docker/dev-certs.sh && docker compose -f docker/compose.dev.yaml up -d",
    "dev:stack:down": "docker compose -f docker/compose.dev.yaml down",
    "assets": "tsx src/assets/cli.ts",
    "assets:watch": "tsx src/assets/cli.ts --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dupes": "jscpd .",
    "oeffentlich": "sh scripts/oeffentlich/pruefen.sh",
    "oeffentlich:bauen": "sh scripts/oeffentlich/bauen-pruefen.sh",
    "secretscan": "sh scripts/secret-scan.sh",
    "migrate": "tsx db/migrate.ts up",
    "migrate:down": "tsx db/migrate.ts down",
    "prepare": "node scripts/kern-vorbereiten.mjs"
  },
  "dependencies": {
    "@fastify/etag": "^6.2.0",
    "@fastify/formbody": "^9.0.0",
    "@node-rs/argon2": "^2.2.1",
    "@simplewebauthn/server": "^14.0.2",
    "better-auth": "^1.7.5",
    "eta": "^4.0.0",
    "fastify": "^5.2.0",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "qrcode-generator": "^2.0.4",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.0.0",
    "js-yaml": "^5.4.2",
    "jscpd": "^5.0.0",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.1"
  }
}
