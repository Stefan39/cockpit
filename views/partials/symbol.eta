<%/*
  Ein Symbol (COPI-43), Strichzeichnung wie im Prototyp. Angabe: `name`. Die Größe setzt das CSS (`.symbol`), nie ein
  Stil-Attribut. Dekorativ: der Text daneben trägt die Bedeutung.
  Aus dem Prototyp: haus, chat, module, glocke, mehr, mond, sonne, suche, warnung, ok. Ergänzt im selben Strich:
  agenten, uhr, zahnrad, person, abmelden, weiter, personen (COPI-45). Aus dem Chat des Prototyps: senden, ki (COPI-53).
  Aus dem Entwurf „Übernahme" (COPI-85): uebernehmen (eine Person, ohne Plus), schloss. Häkchen an eigenen Chat-Nachrichten
  (COPI-69): haken, haken-doppelt. Aus dem Detail des Prototyps: zurueck (COPI-100). Aus dem Entwurf „Posteingang" (COPI-112): posteingang, mail,
  schliessen. Aus dem Entwurf „Agenten-Detailseite" (COPI-113): pfeile (Gespräch zweier Agenten). Aus „Antwort
  freigeben" (COPI-90): stift. Ereignisse der Agenten (COPI-114): blitz. Dark Mode
  „Wie System" (COPI-117): system (ein halb gefüllter Kreis). Aus dem Entwurf „Anhänge" (COPI-110): datei, archiv,
  herunterladen. Aus dem Entwurf „Akquise" (COPI-91): extern (Link nach außen), kopieren. Angeheftetes Modul in der
  Navigation (COPI-121): koffer.
*/%>
<svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><% if (it.name === 'haus') { %><path d="M4 11.5 12 4l8 7.5" /><path d="M6 10v9a1 1 0 0 0 1 1h3v-6h4v6h3a1 1 0 0 0 1-1v-9" /><% } else if (it.name === 'chat') { %><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /><% } else if (it.name === 'module') { %><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /><% } else if (it.name === 'glocke') { %><path d="M6 8a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 12 6 8Z" /><path d="M9.5 17a2.5 2.5 0 0 0 5 0" /><% } else if (it.name === 'mehr') { %><circle cx="5" cy="12" r="1.4" /><circle cx="12" cy="12" r="1.4" /><circle cx="19" cy="12" r="1.4" /><% } else if (it.name === 'mond') { %><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /><% } else if (it.name === 'sonne') { %><circle cx="12" cy="12" r="4.2" /><path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /><% } else if (it.name === 'suche') { %><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /><% } else if (it.name === 'warnung') { %><path d="M12 4.5 21 19.5H3Z" /><path d="M12 10v4" /><path d="M12 16.6h.01" /><% } else if (it.name === 'ok') { %><circle cx="12" cy="12" r="9" /><path d="m8.5 12.5 2.3 2.3L16 10" /><% } else if (it.name === 'personen') { %><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8" /><path d="M18.5 14.2a6.5 6.5 0 0 1 3 5.8" /><% } else if (it.name === 'agenten') { %><rect x="4.5" y="7.5" width="15" height="11" rx="3" /><path d="M12 7.5V4.5" /><path d="M9.5 12.5h.01M14.5 12.5h.01" /><path d="M9.5 15.5h5" /><% } else if (it.name === 'uhr') { %><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /><% } else if (it.name === 'zahnrad') { %><path d="M4 7h9M17 7h3M4 17h3M11 17h9" /><circle cx="15" cy="7" r="2" /><circle cx="9" cy="17" r="2" /><% } else if (it.name === 'person') { %><circle cx="10" cy="8" r="3.5" /><path d="M3.5 20a6.5 6.5 0 0 1 13 0" /><path d="M19 8v6M16 11h6" /><% } else if (it.name === 'abmelden') { %><path d="M14.5 4H18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3.5" /><path d="M9.5 16.5 5 12l4.5-4.5" /><path d="M5 12h10.5" /><% } else if (it.name === 'weiter') { %><path d="m9.5 6 6 6-6 6" /><% } else if (it.name === 'senden') { %><path d="M22 2 11 13" /><path d="m22 2-7 20-4-9-9-4Z" /><% } else if (it.name === 'uebernehmen') { %><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /><% } else if (it.name === 'schloss') { %><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /><% } else if (it.name === 'update') { %><circle cx="12" cy="12" r="9" /><path d="M12 16V8" /><path d="m8.5 11.5 3.5-3.5 3.5 3.5" /><% } else if (it.name === 'haken') { %><path d="m5 12.5 4.5 4.5L19 7" /><% } else if (it.name === 'haken-doppelt') { %><path d="m1.5 12.5 4.5 4.5L15 7" /><path d="m11 15.5 1.5 1.5L22 7" /><% } else if (it.name === 'zurueck') { %><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /><% } else if (it.name === 'posteingang') { %><path d="M3 13h5l1.5 2.5h5L16 13h5" /><path d="M5.6 5h12.8l2.6 8v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5z" /><% } else if (it.name === 'mail') { %><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /><% } else if (it.name === 'schliessen') { %><path d="M6 6l12 12M18 6 6 18" /><% } else if (it.name === 'pfeile') { %><path d="M7 7h11l-3-3" /><path d="M17 17H6l3 3" /><% } else if (it.name === 'stift') { %><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="m13.5 6.5 4 4" /><% } else if (it.name === 'blitz') { %><path d="M13 3 5 13.5h6L10 21l8-10.5h-6Z" /><% } else if (it.name === 'system') { %><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 0 0 17Z" fill="currentColor" /><% } else if (it.name === 'datei') { %><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5" /><% } else if (it.name === 'archiv') { %><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" /><path d="M14 3v5h5" /><path d="M10 7h1M10 10h1M10 13h1" /><rect x="9" y="15" width="3" height="3" rx=".6" /><% } else if (it.name === 'herunterladen') { %><path d="M12 4v11" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M5 20h14" /><% } else if (it.name === 'extern') { %><path d="M14 4h6v6" /><path d="M20 4 11 13" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /><% } else if (it.name === 'kopieren') { %><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /><% } else if (it.name === 'koffer') { %><rect x="3" y="7.5" width="18" height="12" rx="2" /><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5" /><path d="M3 12.5h18" /><% } else if (it.name === 'ki') { %><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" /><% } %></svg>
